#!/bin/sh
# Runs the hanji CLI for the office-documents skill of the Claude Code and
# Codex plugins: `sh scripts/hanji <subcommand> …` takes the same arguments
# as `hanji`. Everything this script says itself goes to stderr; stdout is
# hanji's.
#
# Which binary runs, first match wins:
#   1. $HANJI_BIN, if set.
#   2. hanji on PATH (for example from `cargo install`).
#   3. The release binary for this platform, downloaded once from the
#      GitHub release of this plugin's version into
#      ${XDG_CACHE_HOME:-~/.cache}/hanji/<version>/ and checked against the
#      release's SHA256SUMS.
set -eu

version=0.3.0
repo=sinteric/hanji
base=${HANJI_DOWNLOAD_BASE:-https://github.com/$repo/releases/download/v$version}

say() { printf 'hanji launcher: %s\n' "$*" >&2; }

if [ -n "${HANJI_BIN:-}" ]; then
  exec "$HANJI_BIN" "$@"
fi
if command -v hanji >/dev/null 2>&1; then
  exec hanji "$@"
fi

case "$(uname -s)-$(uname -m)" in
  Linux-x86_64 | Linux-amd64) target=x86_64-unknown-linux-musl ;;
  Linux-aarch64 | Linux-arm64) target=aarch64-unknown-linux-musl ;;
  Darwin-x86_64) target=x86_64-apple-darwin ;;
  Darwin-arm64 | Darwin-aarch64) target=aarch64-apple-darwin ;;
  MINGW*-x86_64 | MSYS*-x86_64 | CYGWIN*-x86_64) target=x86_64-pc-windows-msvc exe=.exe ;;
  *)
    say "no release binary for $(uname -s) $(uname -m). Set HANJI_BIN to a hanji binary, or put hanji on PATH (cargo install --locked --git https://github.com/$repo hanji-cli)."
    exit 1
    ;;
esac

dir=${XDG_CACHE_HOME:-$HOME/.cache}/hanji/$version/$target
bin=$dir/hanji${exe:-}
if [ ! -x "$bin" ]; then
  archive=hanji-$version-$target.tar.gz
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  fetch() {
    http_status=
    if command -v curl >/dev/null 2>&1; then
      if http_status=$(curl -fsSL --retry 2 --write-out '%{http_code}' -o "$2" "$1"); then
        return 0
      fi
    elif command -v wget >/dev/null 2>&1; then
      if wget -q -S -O "$2" "$1" 2>"$tmp/fetch.log"; then
        return 0
      fi
      # Keep the final response, after any redirects to the asset host.
      http_status=$(awk '$1 ~ /^HTTP\// { code = $2 } END { print code }' "$tmp/fetch.log")
    else
      say "needs curl or wget to download $1"
      return 1
    fi
    case "$http_status" in
      404)
        say "release asset not found (HTTP 404): $1. This plugin requires v$version; the release or this asset may not be published yet. From a matching source checkout, run cargo build --locked -p hanji-cli and set HANJI_BIN to the absolute path of target/debug/hanji${exe:-}; or use a plugin version with published release assets."
        ;;
      [45][0-9][0-9])
        say "could not download $1 (HTTP $http_status). Check release availability and access to this URL, or set HANJI_BIN to a locally built hanji binary."
        ;;
      *)
        say "could not download $1. Fix one of: allow network access for this first run (github.com and release-assets.githubusercontent.com); set HANJI_BIN to a hanji binary; or put hanji on PATH (cargo install --locked --git https://github.com/$repo hanji-cli)."
        ;;
    esac
    return 1
  }
  say "downloading $archive (once) from $base"
  for f in "$archive" SHA256SUMS; do
    if ! fetch "$base/$f" "$tmp/$f"; then
      exit 1
    fi
  done
  want=$(awk -v f="$archive" '$2 == f || $2 == "*" f { print $1 }' "$tmp/SHA256SUMS")
  if command -v sha256sum >/dev/null 2>&1; then
    got=$(sha256sum "$tmp/$archive" | awk '{ print $1 }')
  else
    got=$(shasum -a 256 "$tmp/$archive" | awk '{ print $1 }')
  fi
  if [ -z "$want" ] || [ "$want" != "$got" ]; then
    say "checksum mismatch for $archive (expected ${want:-nothing}, got $got); not running it."
    exit 1
  fi
  tar -xzf "$tmp/$archive" -C "$tmp"
  if [ ! -f "$tmp/hanji-$version-$target/hanji${exe:-}" ]; then
    say "$archive has no hanji"
    exit 1
  fi
  mkdir -p "$dir"
  mv -f "$tmp/hanji-$version-$target/hanji${exe:-}" "$dir/hanji${exe:-}.part"
  chmod +x "$dir/hanji${exe:-}.part"
  mv -f "$dir/hanji${exe:-}.part" "$bin"
  rm -rf "$tmp"
  trap - EXIT
  say "installed $bin"
fi
exec "$bin" "$@"
