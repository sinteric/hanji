 <office:master-styles>
  <style:master-page style:name="Standard" style:page-layout-name="pm1">
   <style:header><text:p text:style-name="Standard">3분기 영업 보고 — 내부용</text:p></style:header>
   <style:footer><text:p text:style-name="Standard">쪽 <text:page-number text:select-page="current">1</text:page-number></text:p></style:footer>
